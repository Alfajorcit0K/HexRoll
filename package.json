{
  "name": "ruleta-perks-killers",
  "version": "1.3.1",
  "main": "desktop/main.js",
  "author": "Alfajorcit0K_",
  "license": "MIT",
  "private": true,
  "description": "Ruleta gratuita de perks y killers para OBS, con aportes voluntarios.",
  "scripts": {
    "start": "electron .",
    "start:server": "node editor-ruleta-perks.js",
    "dist:windows": "electron-builder --win nsis --x64 --publish never",
    "build": "node generar_distribucion.js",
    "build:lite": "node generar_distribucion.js --lite",
    "test": "node --test tests/*.test.js",
    "test:desktop": "node scripts/smoke-desktop.js",
    "test:installer": "node scripts/smoke-installer.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.alfajorcit0k.ruletaperkskillers",
    "productName": "Ruleta Perks y Killers",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "desktop/**",
      "editor-ruleta-perks.js",
      "ruleta-core.js",
      "app-state.js",
      "editor-habilidades.html",
      "editor-ui.js",
      "widget-template.html",
      "widget-template-lite.html",
      "data.json",
      "asesinos-default.json",
      "personajes-habilidades.json",
      "config-publica.json",
      "imagenes/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "Ruleta-Perks-Killers-${version}-Setup.${ext}"
    },
    "nsis": {
      "include": "installer/running-app.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ruleta Perks y Killers",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  }
}
