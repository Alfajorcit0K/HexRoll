{
  "name": "hexroll",
  "version": "1.0.0",
  "main": "desktop/main.js",
  "author": "Alfajorcit0K_",
  "license": "MIT",
  "private": true,
  "description": "HexRoll: ruletas de perks y personajes de Dead by Daylight para OBS.",
  "scripts": {
    "start": "electron .",
    "start:server": "node Server.js",
    "dist:windows": "electron-builder --win nsis --x64 --publish never",
    "build": "node Build.js",
    "build:lite": "node Build.js --lite",
    "test": "node --test tests/*.test.js",
    "test:desktop": "node scripts/DesktopSmoke.js",
    "test:installer": "node scripts/InstallerSmoke.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.alfajorcit0k.ruletaperkskillers",
    "productName": "HexRoll",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "beforePack": "scripts/PrepareWidgets.js",
    "extraFiles": [{ "from": ".build-cache/InstallerWidgets", "to": ".", "filter": ["**/*"] }],
    "files": [
      "desktop/**",
      "Server.js",
      "Roulette.js",
      "State.js",
      "Editor.html",
      "Editor.js",
      "Theme.js",
      "WidgetFiles.js",
      "RouletteTemplate.html",
      "RouletteLiteTemplate.html",
      "data.json",
      "Killers.json",
      "Characters.json",
      "SurvivorPortraits.json",
      "AppLinks.json",
      "images/**",
      "LICENSE",
      "Credits.md"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "artifactName": "HexRollSetup${version}.${ext}",
      "icon": "images/brand/HexRoll.png",
      "signExecutable": false
    },
    "nsis": {
      "include": "installer/WindowGuard.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HexRoll",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Alfajorcit0K",
      "repo": "Perks-Killer-Roulette",
      "private": false,
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
